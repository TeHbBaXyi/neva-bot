# Токен Telegram-бота, полученный у @BotFather. Никогда не публикуйте реальный токен.
BOT_TOKEN=1234567890:ЗАМЕНИТЕ_НА_ТОКЕН_БОТА

# Числовые Telegram ID администраторов через запятую, без пробелов.
ADMIN_IDS=123456789,987654321

# Локальная PostgreSQL 17 на Windows. Замените ПАРОЛЬ на пароль пользователя postgres.
# host.docker.internal позволяет контейнеру обратиться к базе на вашем компьютере.
DATABASE_URL=postgresql+asyncpg://postgres:ПАРОЛЬ@host.docker.internal:5432/neva_bot

# Локально оставьте пустым. deploy.sh сам создаст отдельный пароль для базы на сервере.
POSTGRES_PASSWORD=
